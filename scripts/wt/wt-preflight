#!/bin/sh
# If any docker compose stack for the current repo is running in another
# worktree, prompt the user to stop them before starting a new one here.
#
# Multiple "other" stacks are listed together and stopped in one decision.
#
# Options:
#   -y, --yes   Auto-confirm stopping the other worktrees' stacks (non-interactive)
#
# Exit codes:
#   0 — no conflict, or user accepted to stop the other worktrees' stacks
#   1 — user declined, bail out

set -u

assume_yes=0
while [ $# -gt 0 ]; do
  case "$1" in
    -y|--yes) assume_yes=1; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done

SELF=$(readlink -f "$0")
SCRIPT_DIR=$(cd "$(dirname "$SELF")" && pwd)
# shellcheck source=lib/wt-lib.sh
. "$SCRIPT_DIR/lib/wt-lib.sh"

cwd=$PWD

current_worktree=$(git -C "$cwd" --no-optional-locks rev-parse --show-toplevel 2>/dev/null)
if [ -z "$current_worktree" ]; then
  exit 0
fi

# Reap orphan `docker compose watch` from previous sessions of this worktree.
# `docker compose down` (used when swapping stacks across worktrees) does NOT
# terminate the watch process, so it keeps holding the project lock and blocks
# the next `wt watch` from starting in the same worktree.
orphans=$(list_compose_watch_pids_in_cwd "$current_worktree")
if [ -n "$orphans" ]; then
  printf 'wt: cleaning up orphan docker compose watch from previous session(s):\n' >&2
  printf '%s\n' "$orphans" | while IFS= read -r pid; do
    [ -n "$pid" ] || continue
    cmd=$(ps -o command= -p "$pid" 2>/dev/null)
    printf '  - pid=%s: %s\n' "$pid" "$cmd" >&2
    kill "$pid" 2>/dev/null || true
  done
  # Give them a moment to release the lock; force-kill any stragglers.
  sleep 1
  remaining=$(list_compose_watch_pids_in_cwd "$current_worktree")
  if [ -n "$remaining" ]; then
    printf '%s\n' "$remaining" | while IFS= read -r pid; do
      [ -n "$pid" ] || continue
      kill -9 "$pid" 2>/dev/null || true
    done
  fi
fi

others_file=$(mktemp -t wt-others.XXXXXX) || exit 1
trap 'rm -f "$others_file"' EXIT

find_running_stacks_for_repo "$cwd" \
  | awk -F'\t' -v self="$current_worktree" '$1 != self { print $1 "\t" $3 }' \
  > "$others_file"

if [ ! -s "$others_file" ]; then
  exit 0
fi

printf 'docker compose is already running in other worktree(s) of this repo:\n' >&2
while IFS="$(printf '\t')" read -r hit_dir hit_proj; do
  hit_branch=$(resolve_branch_of_path "$hit_dir")
  hit_label=${hit_branch:-$(basename "$hit_dir")}
  printf '  - %s (project: %s)\n    path: %s\n' "$hit_label" "$hit_proj" "$hit_dir" >&2
done < "$others_file"

stop_all() {
  # Target stacks purely by `-p <project>` (the actual COMPOSE_PROJECT_NAME the
  # stack was started with). `docker compose -p NAME down` resolves containers
  # via their compose labels, so it needs neither the compose file nor the
  # worktree directory. This lets us stop a stack even when its worktree has
  # been deleted (git still lists such worktrees as "prunable"); cd-ing into a
  # missing $hit_dir would otherwise fail and abort the whole swap.
  while IFS="$(printf '\t')" read -r hit_dir hit_proj; do
    docker compose -p "$hit_proj" down || return 1
  done < "$others_file"
}

if [ "$assume_yes" -eq 1 ]; then
  printf 'Stop them and continue here? [y/N] y (auto)\n' >&2
  stop_all || exit 1
  exit 0
fi

printf 'Stop them and continue here? [y/N] ' >&2
read -r answer </dev/tty || exit 1

case "$answer" in
  y|Y|yes|YES)
    stop_all || exit 1
    exit 0
    ;;
  *)
    printf 'Aborted.\n' >&2
    exit 1
    ;;
esac
