#!/bin/sh
# Report the running docker compose stack(s) for the repo containing $1
# (default: $PWD), one TSV line per stack:
#   <kind>\t<branch>\t<worktree_path>
# where <kind> is "self" if the stack's worktree is $cwd's worktree, else "other".
# Empty output if no stack is running for the repo (or $cwd is not in a git repo).

set -u

SELF=$(readlink -f "$0")
SCRIPT_DIR=$(cd "$(dirname "$SELF")" && pwd)
# shellcheck source=lib/wt-lib.sh
. "$SCRIPT_DIR/lib/wt-lib.sh"

cwd=${1:-$PWD}

current_worktree=$(git -C "$cwd" --no-optional-locks rev-parse --show-toplevel 2>/dev/null)
[ -z "$current_worktree" ] && exit 0

find_running_stacks_for_repo "$cwd" | awk -F'\t' '{print $1}' | while read -r dir; do
  if [ "$dir" = "$current_worktree" ]; then
    kind=self
  else
    kind=other
  fi
  branch=$(resolve_branch_of_path "$dir")
  printf '%s\t%s\t%s\n' "$kind" "${branch:-$(basename "$dir")}" "$dir"
done
