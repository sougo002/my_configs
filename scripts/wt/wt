#!/bin/sh
# wt — worktree-aware docker compose dispatcher.
#
# Problem it solves:
#   When you use git worktrees and each worktree has its own docker-compose.yml
#   sharing the same host ports, only one worktree's stack can run at a time.
#   It's easy to forget which worktree is up, start another, and hit port
#   conflicts or tear down the wrong stack.
#
#   `wt` keeps track of the running worktree and swaps safely.

set -u

SELF=$(readlink -f "$0")
SCRIPT_DIR=$(cd "$(dirname "$SELF")" && pwd)

usage() {
  cat >&2 <<'EOF'
wt — worktree-aware docker compose dispatcher

Usage:
  wt up [-y] [args...]    Start docker compose in the current worktree
                          (detached, with --build so the image always reflects
                          the current worktree's state), then watch for file
                          changes and follow logs. If another worktree of the
                          same repo has a stack running, prompt to stop it
                          first.
  wt watch [-y] [args...] Run docker compose watch with the same conflict check.
  wt where                Show which worktree (if any) is currently running
                          docker compose for the repo containing $PWD.
  wt --help               Show this help.

Options:
  -y, --yes   Auto-confirm stopping another worktree's running stack.
EOF
}

sub=${1:-}
[ $# -gt 0 ] && shift

# For up/watch, strip -y/--yes from positional params (preserving order & whitespace).
# Sets $preflight_yes to "-y" when present. Inlined because a function cannot
# modify the caller's positional parameters.
case "$sub" in
  up|watch)
    preflight_yes=""
    _orig=$#
    _i=0
    while [ "$_i" -lt "$_orig" ]; do
      _arg=$1
      shift
      case "$_arg" in
        -y|--yes) preflight_yes="-y" ;;
        *) set -- "$@" "$_arg" ;;
      esac
      _i=$((_i + 1))
    done
    ;;
esac

case "$sub" in
  up)
    "$SCRIPT_DIR/wt-preflight" $preflight_yes || exit 1
    docker compose up -d --build "$@" || exit 1
    docker compose watch --no-up &
    WATCH_PID=$!
    trap 'kill $WATCH_PID 2>/dev/null' EXIT INT TERM
    docker compose logs -f
    ;;
  watch)
    "$SCRIPT_DIR/wt-preflight" $preflight_yes || exit 1
    docker compose watch "$@"
    ;;
  where)
    "$SCRIPT_DIR/wt-status" "$PWD" --verbose
    ;;
  -h|--help|help)
    usage
    ;;
  "")
    usage
    exit 1
    ;;
  *)
    printf 'wt: unknown subcommand %s\n\n' "$sub" >&2
    usage
    exit 1
    ;;
esac
