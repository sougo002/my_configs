#!/bin/sh
# wt — worktree-aware docker compose dispatcher.
#
# Detects "another stack with the same COMPOSE_PROJECT_NAME is already up
# elsewhere" and prompts before swapping. With -p NAME (or by exporting
# COMPOSE_PROJECT_NAME yourself), different repos / worktrees can run in
# parallel under distinct project names.

set -u

SELF=$(readlink -f "$0")
SCRIPT_DIR=$(cd "$(dirname "$SELF")" && pwd)
# shellcheck source=lib/wt-lib.sh
. "$SCRIPT_DIR/lib/wt-lib.sh"

usage() {
  cat >&2 <<'EOF'
wt — worktree-aware docker compose dispatcher

Usage:
  wt up    [opts] [args]   Run `compose up --build` (foreground)
  wt watch [opts] [args]   Run `compose watch`
  wt where                 Show running stack for this project
  wt --help                Show this help

Options:
  -y, --yes          Auto-confirm stopping conflicting stack
  -d, --detach       Background mode (logs to /tmp)
  -p, --project N    Set COMPOSE_PROJECT_NAME (parallel runs)

If a stack with the same project name is running elsewhere,
up/watch prompts before swapping. For per-repo parallelism,
pass distinct -p NAME or export COMPOSE_PROJECT_NAME first.
EOF
}

sub=${1:-}
[ $# -gt 0 ] && shift

# For up/watch: strip wt-level flags from positional params.
# Sets $preflight_yes / $detach / $project. Inlined because a function cannot
# modify the caller's positional parameters.
case "$sub" in
  up|watch)
    preflight_yes=""
    detach=""
    project=""
    _orig=$#
    _i=0
    while [ "$_i" -lt "$_orig" ]; do
      _arg=$1
      shift
      case "$_arg" in
        -y|--yes) preflight_yes="-y" ;;
        -d|--detach) detach="1" ;;
        -p|--project)
          if [ "$_i" -ge "$((_orig - 1))" ]; then
            printf 'wt: %s requires an argument\n' "$_arg" >&2
            exit 1
          fi
          project=$1
          shift
          _i=$((_i + 1))
          ;;
        --project=*) project=${_arg#--project=} ;;
        -p=*) project=${_arg#-p=} ;;
        *) set -- "$@" "$_arg" ;;
      esac
      _i=$((_i + 1))
    done
    if [ -z "$project" ] && [ -z "${COMPOSE_PROJECT_NAME:-}" ]; then
      # Auto-derive a per-repo, per-worktree project name so that worktrees
      # with the same basename across different repos don't collide on the
      # cwd-derived default.
      project=$(compute_default_project_name "$PWD")
    fi
    if [ -n "$project" ]; then
      COMPOSE_PROJECT_NAME=$project
      export COMPOSE_PROJECT_NAME
    fi
    ;;
esac

case "$sub" in
  up)
    "$SCRIPT_DIR/wt-preflight" $preflight_yes || exit 1
    if [ -n "$detach" ]; then
      docker compose up -d --build "$@"
    else
      docker compose up --build "$@"
    fi
    ;;
  watch)
    "$SCRIPT_DIR/wt-preflight" $preflight_yes || exit 1
    if [ -n "$detach" ]; then
      log_tag=${COMPOSE_PROJECT_NAME:-$(basename "$PWD")}
      log_file="/tmp/wt-watch-${log_tag}-$$.log"
      nohup docker compose watch "$@" >"$log_file" 2>&1 &
      printf 'wt watch started in background (pid=%s, log=%s)\n' "$!" "$log_file"
    else
      docker compose watch "$@"
    fi
    ;;
  where)
    "$SCRIPT_DIR/wt-status" "$PWD" --verbose
    ;;
  -h|--help|help)
    usage
    ;;
  "")
    usage
    exit 1
    ;;
  *)
    printf 'wt: unknown subcommand %s\n\n' "$sub" >&2
    usage
    exit 1
    ;;
esac
