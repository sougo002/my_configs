#!/usr/bin/env bash
set -euo pipefail

# Preview script for gv (ghq + fzf).
#
# Usage:
#   gv-fzf-preview <repo_full_path>

ghq_repo_slug() {
  local root rel
  root=$(ghq root 2>/dev/null) || return 1
  rel="${1#"$root"/}"
  rel="${rel#github.com/}"
  printf '%s\n' "$rel"
}

repo_path="${1:-}"

if [[ -z "$repo_path" || ! -d "$repo_path" ]]; then
  echo "Not a directory: ${repo_path:-<empty>}"
  exit 0
fi

dir_name=$(basename "$repo_path")
repo_slug=$(ghq_repo_slug "$repo_path" 2>/dev/null || true)

if [[ $dir_name =~ -issue-([0-9]+)$ && -n $repo_slug ]]; then
  number="${BASH_REMATCH[1]}"
  echo "=== Issue #${number} ==="
  gh issue view "$number" --repo "$repo_slug" \
    --json state,title,closedAt \
    --jq '"Title: " + .title + "\nState: " + .state + (if .closedAt then "\nClosed: " + .closedAt else "" end)' \
    2>/dev/null || echo "Failed to fetch issue info"
elif [[ $dir_name =~ -pr-([0-9]+)$ && -n $repo_slug ]]; then
  number="${BASH_REMATCH[1]}"
  echo "=== PR #${number} ==="
  gh pr view "$number" --repo "$repo_slug" \
    --json state,title,closedAt,mergedAt \
    --jq '"Title: " + .title + "\nState: " + .state + (if .mergedAt then "\nMerged: " + .mergedAt elif .closedAt then "\nClosed: " + .closedAt else "" end)' \
    2>/dev/null || echo "Failed to fetch PR info"
fi

echo "=== Upstream ==="
branch_name=$(git -C "$repo_path" symbolic-ref --short HEAD 2>/dev/null || true)
if [[ -n $branch_name ]]; then
  upstream=$(git -C "$repo_path" for-each-ref --format='%(upstream:short)' "refs/heads/${branch_name}" 2>/dev/null || true)
  if [[ -n $upstream ]]; then
    echo "Branch: ${branch_name} -> ${upstream}"
    ahead_behind=$(git -C "$repo_path" rev-list --left-right --count "${branch_name}...${upstream}" 2>/dev/null || true)
    if [[ -n $ahead_behind ]]; then
      ahead=$(echo "$ahead_behind" | awk '{print $1}')
      behind=$(echo "$ahead_behind" | awk '{print $2}')
      echo "Ahead: ${ahead}, Behind: ${behind}"
    fi
  else
    echo "Branch: ${branch_name} (no upstream)"
  fi
else
  echo "Detached HEAD"
fi
echo

echo "=== Status ==="
git -C "$repo_path" --no-optional-locks status -sb 2>/dev/null || true
echo

echo "=== Log ==="
git -C "$repo_path" log -n 10 --oneline --color=always 2>/dev/null || true
echo

echo "=== Tree ==="
if command -v eza &>/dev/null; then
  eza --tree --level=2 --icons=auto "$repo_path" 2>/dev/null || true
else
  find "$repo_path" -maxdepth 2 -mindepth 1 2>/dev/null | head -30
fi
